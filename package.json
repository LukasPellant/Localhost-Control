{
  "name": "localhost-control",
  "version": "0.1.7",
  "private": true,
  "description": "Find, check, clean, and stop localhost development servers from a clean browser side panel.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --sort build",
    "test": "vitest && pnpm -r --sort test",
    "test:run": "vitest run && pnpm -r --sort test:run",
    "smoke:native-host": "cargo test -p localhost-control-host",
    "typecheck": "pnpm --filter @localhost-control/shared build && pnpm -r --sort typecheck",
    "extension:package": "powershell -ExecutionPolicy Bypass -File scripts/package-extension.ps1",
    "extension:package:chrome": "powershell -ExecutionPolicy Bypass -File scripts/package-extension.ps1 -Target chrome",
    "extension:package:firefox": "powershell -ExecutionPolicy Bypass -File scripts/package-extension.ps1 -Target firefox",
    "extension:verify": "pnpm extension:verify:chrome && pnpm extension:verify:firefox",
    "extension:verify:chrome": "node scripts/validate-extension-package.mjs --target=chrome",
    "extension:verify:firefox": "node scripts/validate-extension-package.mjs --target=firefox",
    "host:install": "powershell -ExecutionPolicy Bypass -File installer/windows/install.ps1",
    "host:uninstall": "powershell -ExecutionPolicy Bypass -File installer/windows/uninstall.ps1",
    "host:build:windows": "cargo build --release -p localhost-control-host",
    "host:test:windows-rust": "cargo test -p localhost-control-host",
    "host:install:mac": "cargo build --release -p localhost-control-host && bash installer/macos/install.sh target/release/localhost-control-host",
    "host:uninstall:mac": "bash installer/macos/uninstall.sh",
    "host:install:linux": "cargo build --release -p localhost-control-host && bash installer/linux/install.sh target/release/localhost-control-host",
    "host:uninstall:linux": "bash installer/linux/uninstall.sh",
    "host:package:windows": "node scripts/package-native-host.mjs --platform=win32 --format=zip",
    "host:package:mac": "node scripts/package-native-host.mjs --platform=darwin --format=tarball && node scripts/package-native-host.mjs --platform=darwin --format=pkg",
    "host:package:mac:tarball": "node scripts/package-native-host.mjs --platform=darwin --format=tarball",
    "host:package:linux": "node scripts/package-native-host.mjs --platform=linux --format=tarball && node scripts/package-native-host.mjs --platform=linux --format=deb",
    "host:package:release-local": "pnpm host:package:mac:tarball && pnpm host:package:linux && pnpm host:verify:release-local && node scripts/write-native-host-checksums.mjs",
    "host:verify:windows": "node scripts/validate-native-host-package.mjs --platform=win32 --format=zip",
    "host:verify:mac": "node scripts/validate-native-host-package.mjs --platform=darwin --format=tarball && node scripts/validate-native-host-package.mjs --platform=darwin --format=pkg",
    "host:verify:mac:tarball": "node scripts/validate-native-host-package.mjs --platform=darwin --format=tarball",
    "host:verify:linux": "node scripts/validate-native-host-package.mjs --platform=linux --format=tarball && node scripts/validate-native-host-package.mjs --platform=linux --format=deb",
    "host:verify:release-local": "pnpm host:verify:windows && pnpm host:verify:mac:tarball && pnpm host:verify:linux"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.7.0"
}
