{
  "name": "localhost-control",
  "version": "0.1.2",
  "private": true,
  "description": "A Brave/Chromium side panel for finding and killing stale localhost dev servers.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --sort build",
    "test": "pnpm -r --sort test",
    "test:run": "pnpm -r --sort test:run",
    "typecheck": "pnpm -r --sort typecheck",
    "extension:package": "powershell -ExecutionPolicy Bypass -File scripts/package-extension.ps1",
    "host:install": "powershell -ExecutionPolicy Bypass -File installer/windows/install.ps1",
    "host:uninstall": "powershell -ExecutionPolicy Bypass -File installer/windows/uninstall.ps1",
    "host:install:mac": "bash installer/macos/install.sh",
    "host:uninstall:mac": "bash installer/macos/uninstall.sh",
    "host:install:linux": "bash installer/linux/install.sh",
    "host:uninstall:linux": "bash installer/linux/uninstall.sh",
    "host:package:mac": "pnpm --filter @localhost-control/native-host build && node scripts/package-native-host.mjs --platform=darwin --format=pkg",
    "host:package:linux": "pnpm --filter @localhost-control/native-host build && node scripts/package-native-host.mjs --platform=linux --format=tarball && node scripts/package-native-host.mjs --platform=linux --format=deb"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.7.0"
}
